1. 	CMD
	C:\Users\Administrator> sqlplus / as sysdba
2.	(OPTIONAL) SELECT log_mode FROM v$database;    ---NOARCHIVELOG---
3.	SHUTDOWN IMMEDIATE;
4.	STARTUP MOUNT;
5.	ALTER DATABASE ARCHIVELOG;
6.	ALTER DATABASE OPEN;
7.	(OPTIONAL) SELECT log_mode FROM v$database; ---CONFIRM IF ARCHIVELOG---
8.	EXIT;
9.	rman target /
10.	BACKUP DATABASE PLUS ARCHIVELOG;
	----Backup Pluggable Database----
11.	backup pluggable database posdb;

		-----------IF PBDS IN MOUNT STATE-----
12.    ALTER PLUGGABLE DATABASE FREEPDB1 OPEN;
-------------------------------------------------STRUCTRE OF MY DATABASE------------------------------------------------
					Type	Name		Status
					CDB		FREE		Main Database
					PDB		PDB$SEED	READ ONLY (Oracle ka template, isay use nahi karte)
					PDB		FREEPDB1	READ WRITE 
					PDB		POSDB		mounted  ---if mounted--the 13.

13.		rman target /
14.		RECOVER PLUGGABLE DATABASE POSDB;
15.		sqlplus / as sysdba
16.		ALTER SESSION SET CONTAINER=POSDB;
17.		ALTER PLUGGABLE DATABASE POSDB OPEN;
18.		LIST BACKUP SUMMARY;

-------------------------------------------------STRUCTRE OF MY DATABASE RECOVERY------------------------------------------------
1.		PDB Close Karna
		ALTER PLUGGABLE DATABASE HRDB CLOSE IMMEDIATE;
									Ye command kya karti hai?
							HRDB PDB ko immediately band (close) kar deti hai.
							Saare active sessions disconnect ho jate hain.
							Database files restore ke liye ready ho jati hain.
Verify karein
SELECT NAME, OPEN_MODE
FROM V$PDBS;

2.		Restore
		RMAN mein:
		RESTORE PLUGGABLE DATABASE HRDB;

3.		Database Open
		ALTER PLUGGABLE DATABASE HRDB OPEN;









